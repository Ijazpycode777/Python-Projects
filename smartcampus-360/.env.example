# ===== SmartCampus 360 — Environment Configuration =====
# Copy this file to ".env" for local development. NEVER commit the .env file.
#
# On Render, you do NOT need a .env file — set these as environment variables
# in the Render dashboard (or use render.yaml, which auto-generates the
# secrets marked `generateValue: true`). See README.md → "Deploy on Render".

# Application port. Render injects its own PORT at runtime; this default is
# only used for local development.
PORT=4000

# Node environment: development | production
# Render sets this to production automatically for web services.
NODE_ENV=development

# Long random string used to sign session cookies.
# Local:   openssl rand -hex 64
# Render:  set `generateValue: true` in render.yaml (or add it manually)
SESSION_SECRET=change-me-to-a-long-random-hex-string

# 32-byte (256-bit) key for AES-256-GCM encryption of sensitive session
# data at rest.
# Local:   openssl rand -base64 32
# Render:  set `generateValue: true` in render.yaml (or add it manually)
SESSION_ENCRYPTION_KEY=change-me-to-a-base64-32-byte-key

# Path to the SQLite database file.
# Local:   ./data/smartcampus.db
# Render:  /var/data/smartcampus.db  (on the attached persistent disk)
DATABASE_PATH=./data/smartcampus.db

# Directory for uploaded files. Keep this OUTSIDE the Vite public/ directory.
# Render: /var/data/uploads
FILE_STORAGE_PATH=./uploads

# The frontend origin (used for CORS and CSRF Origin validation).
# Local:   http://localhost:5173
# Render:  https://your-service-name.onrender.com
FRONTEND_URL=http://localhost:5173

# External AI provider API key (optional). If absent, AI features gracefully
# degrade to deterministic rule-based responses, never pretending to call a
# live service.
AI_API_KEY=

# Session cookie max age in milliseconds (default: 8 hours)
SESSION_MAX_AGE=28800000

# Session inactivity timeout in milliseconds (default: 30 minutes)
SESSION_INACTIVITY_TIMEOUT=1800000
